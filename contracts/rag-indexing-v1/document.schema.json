{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-indexing-v1/document.schema.json",
  "title": "Portable RAG indexing document",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "path", "pocket", "scopes", "authority", "priority", "content"],
  "properties": {
    "format": {"enum": ["markdown", "text"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "pocket": {"type": "string", "minLength": 1, "maxLength": 256},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "authority": {
      "enum": ["global_record", "workspace_record", "persona_vault", "conversation_memory", "unclassified"]
    },
    "priority": {"type": "integer", "minimum": -100, "maximum": 100},
    "content": {"type": "string"}
  }
}
