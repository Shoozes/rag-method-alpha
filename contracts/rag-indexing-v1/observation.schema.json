{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-indexing-v1/observation.schema.json",
  "title": "Portable RAG indexing observation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "document"],
      "properties": {
        "status": {"const": "ok"},
        "document": {"$ref": "#/$defs/indexed_document"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": {"const": "error"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {"code": {"type": "string", "minLength": 1}}
        }
      }
    }
  ],
  "$defs": {
    "indexed_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "path", "pocket", "scopes", "authority", "priority",
        "source_id", "source_content_id", "source_utf8_bytes",
        "canonical_content_id", "canonical_scalar_count", "normalization",
        "limits", "records"
      ],
      "properties": {
        "format": {"enum": ["markdown", "text"]},
        "path": {"type": "string", "minLength": 1},
        "pocket": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": -100, "maximum": 100},
        "source_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_content_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_utf8_bytes": {"type": "integer", "minimum": 0, "maximum": 10485760},
        "canonical_content_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_scalar_count": {"type": "integer", "minimum": 0},
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bom_removed", "line_endings_changed", "frontmatter_removed"],
          "properties": {
            "bom_removed": {"type": "boolean"},
            "line_endings_changed": {"type": "boolean"},
            "frontmatter_removed": {"type": "boolean"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_chars", "max_tokens"],
          "properties": {
            "max_chars": {"type": "integer", "minimum": 1, "maximum": 2400},
            "max_tokens": {"type": "integer", "minimum": 1, "maximum": 600}
          }
        },
        "records": {
          "type": "array",
          "items": {"$ref": "../rag-behavior-v2/record.schema.json"}
        }
      }
    }
  }
}
