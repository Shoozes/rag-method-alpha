    {
      "id": "reference_candidate_rerank",
      "query": "stable marker",
      "mode": "exact_only",
      "top_k": 2,
      "include_scopes": ["global", "workspace:edge"]
    },
    {
      "id": "source_diversity",
      "query": "diversity beacon",
      "mode": "exact_only",
      "top_k": 3,
      "include_scopes": ["test:diversity"]
    },
    {
      "id": "complete_tie_break",
      "query": "shared duplicate content",
      "mode": "exact_only",
      "top_k": 2,
      "include_scopes": ["test:tie"]
