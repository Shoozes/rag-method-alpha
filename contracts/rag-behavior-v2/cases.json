      "mode": "keyword_only",
      "top_k": 3,
      "include_scopes": ["workspace:edge"]
    },
    {
      "id": "semantic_threshold_inclusive",
      "query": "unrelated semantic wording",
      "mode": "semantic_only",
      "top_k": 3,
      "include_scopes": ["test:threshold"],
      "query_vector_id": "semantic-threshold"
    },
    {
      "id": "semantic_profile_mismatch",
      "query": "profile drift",
      "mode": "semantic_only",
      "top_k": 3,
      "include_scopes": ["test:mismatch"],
      "query_vector_id": "semantic-mismatch"
    },
    {
      "id": "hybrid_aggregate",
      "query": "color marks readiness",
      "mode": "hybrid",
      "top_k": 3,
      "include_scopes": ["global", "workspace:edge"],
