{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-behavior-v2/report.schema.json",
  "title": "RAG behavior v2 adapter report",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "profile_id", "runner", "repository", "summary", "results"],
  "properties": {
    "contract": {"const": "rag-behavior-v2-report"},
    "profile_id": {"const": "rag-behavior-v2-edge-derived"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "language", "version"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "version": {"const": 1}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "passed", "failed"],
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "passed", "expected", "actual"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mode": {
            "enum": ["exact_only", "semantic_only", "keyword_only", "hybrid", "scoped_hybrid"]
          },
          "passed": {"type": "boolean"},
          "expected": {"$ref": "#/$defs/observation"},
          "actual": {"$ref": "#/$defs/observation"}
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_ids",
        "candidate_ids",
        "ordered_ids",
        "scores",
        "context_selected_ids",
        "context_tokens",
        "truncated",
        "semantic_state",
        "semantic_fallback_reason",
        "errors"
      ],
      "properties": {
        "eligible_ids": {"$ref": "#/$defs/ids"},
        "candidate_ids": {"$ref": "#/$defs/ids"},
        "ordered_ids": {"$ref": "#/$defs/ids"},
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "score_micro", "components", "cross_reference_from_id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "score_micro": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "components": {"$ref": "response.schema.json#/$defs/components"},
              "cross_reference_from_id": {
                "type": ["string", "null"],
                "minLength": 1
              }
            }
          }
        },
        "context_selected_ids": {"$ref": "#/$defs/ids"},
        "context_tokens": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "semantic_state": {
          "enum": ["not_requested", "ready", "disabled_by_settings", "lexical_fallback"]
        },
        "semantic_fallback_reason": {
          "enum": [null, "disabled_by_settings", "no_compatible_vectors", "embedding_failed"]
        },
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "semantic_state": {"enum": ["not_requested", "ready"]}
            },
            "required": ["semantic_state"]
          },
          "then": {
            "properties": {"semantic_fallback_reason": {"const": null}}
          }
        },
        {
          "if": {
            "properties": {
              "semantic_state": {"const": "disabled_by_settings"}
            },
            "required": ["semantic_state"]
          },
          "then": {
            "properties": {
              "semantic_fallback_reason": {"const": "disabled_by_settings"}
            }
          }
        },
        {
          "if": {
            "properties": {"semantic_state": {"const": "lexical_fallback"}},
            "required": ["semantic_state"]
          },
          "then": {
            "properties": {
              "semantic_fallback_reason": {
                "enum": ["no_compatible_vectors", "embedding_failed"]
              }
            }
          }
        }
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
